#!/usr/bin/env bash
# twinr: start/stop/restart the twin-r local dev stack (scenario API + web
# frontend) in a tmux session, so both run in the background across
# terminal sessions instead of needing two manually-managed `nohup` shells
# (see docs/ for the "server wasn't running" class of bug this replaces).
#
# Usage: twinr start|restart [local|prod]  |  twinr stop|status|attach
#
# `local` (default): both a local uvicorn scenario API and the web
# frontend, matching the original behavior.
# `prod`: only the web frontend, pointed at the deployed AWS backend
# (see docs/deploy-aws-setup.md) instead of starting a local API -- for
# checking the real deployed backend from the local dev frontend, e.g. to
# reproduce docs/known-issues-cloud-deploy.md's latency findings.
#
# Optional: symlink this onto your PATH, e.g.:
#   ln -s "$(pwd)/bin/twinr" /usr/local/bin/twinr

set -euo pipefail

SESSION="twinr"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Defaults to the national dataset (see README's Quickstart for how it's
# built). buildings.parquet is always a per-municipality partitioned glob
# (no single combined file exists, by design -- region.py); exposure.parquet
# is a single combined file (region.combine_exposure), regenerated whenever
# the crawl changes. Override for a smaller/faster local dataset, e.g. a
# single-municipality test crawl:
#   TWIN_R_BUILDINGS_PATH="data/test-municipality/parts/*.buildings.parquet" \
#   TWIN_R_EXPOSURE_PATH="data/test-municipality/exposure.parquet" \
#   twinr start
: "${TWIN_R_BUILDINGS_PATH:=data/exposure/parts/*.buildings.parquet}"
: "${TWIN_R_EXPOSURE_PATH:=data/exposure/exposure.parquet}"

# The deployed Lambda Function URL (infra's `ScenarioFunctionUrl` CDK
# output, docs/deploy-aws-setup.md step 7/9) -- override if you've deployed
# your own stack/account, e.g.:
#   TWIN_R_PROD_SCENARIO_API_URL="https://..." twinr start prod
: "${TWIN_R_PROD_SCENARIO_API_URL:=https://naw44z44znff5je2ohuyyai7ce0gwpiu.lambda-url.eu-south-2.on.aws/}"

API_CMD="cd '$REPO_ROOT' && TWIN_R_BUILDINGS_PATH='$TWIN_R_BUILDINGS_PATH' TWIN_R_EXPOSURE_PATH='$TWIN_R_EXPOSURE_PATH' uv run --package twin-r-scenario uvicorn scenario.local:app --port 8000 --reload"
WEB_CMD_LOCAL="cd '$REPO_ROOT/apps/web' && npm run dev -- --port 5173"
# VITE_SCENARIO_API_URL set here always wins over apps/web/.env* files
# (Vite: process.env takes priority over .env-file values), so this is the
# one place mode selection actually happens -- no dotenv juggling needed.
WEB_CMD_PROD="cd '$REPO_ROOT/apps/web' && VITE_SCENARIO_API_URL='$TWIN_R_PROD_SCENARIO_API_URL' npm run dev -- --port 5173"

is_running() {
  tmux has-session -t "$SESSION" 2>/dev/null
}

cmd_start() {
  local mode="${1:-local}"
  case "$mode" in
    local|prod) ;;
    *)
      echo "twinr: unknown mode '$mode' (expected 'local' or 'prod')" >&2
      exit 2
      ;;
  esac

  if is_running; then
    echo "twinr: already running (session '$SESSION'). Use 'twinr status' or 'twinr attach'."
    exit 0
  fi

  if [ "$mode" = "local" ]; then
    tmux new-session -d -s "$SESSION" -n api "$API_CMD"
    tmux new-window -t "$SESSION" -n web "$WEB_CMD_LOCAL"
    echo "twinr: started (local)."
    echo "  scenario API: http://localhost:8000  (tmux window 'api')"
    echo "  web frontend: http://localhost:5173  (tmux window 'web')"
  else
    tmux new-session -d -s "$SESSION" -n web "$WEB_CMD_PROD"
    echo "twinr: started (prod)."
    echo "  scenario API: $TWIN_R_PROD_SCENARIO_API_URL  (deployed AWS backend, no local API window)"
    echo "  web frontend: http://localhost:5173  (tmux window 'web')"
    echo "  note: the deployed backend is much slower for large-radius faults"
    echo "  (seconds, not milliseconds) -- see docs/known-issues-cloud-deploy.md."
  fi
  echo "  attach with: twinr attach   (or: tmux attach -t $SESSION)"
}

cmd_stop() {
  if ! is_running; then
    echo "twinr: not running."
    exit 0
  fi
  tmux kill-session -t "$SESSION"
  echo "twinr: stopped."
}

cmd_restart() {
  local mode="${1:-local}"
  is_running && cmd_stop
  cmd_start "$mode"
}

cmd_status() {
  if is_running; then
    echo "twinr: running."
    tmux list-windows -t "$SESSION" -F '  #{window_name}: #{pane_current_command}'
  else
    echo "twinr: not running."
  fi
}

cmd_attach() {
  is_running || { echo "twinr: not running. Run 'twinr start' first." >&2; exit 1; }
  tmux attach -t "$SESSION"
}

case "${1:-}" in
  start)   cmd_start "${2:-local}" ;;
  stop)    cmd_stop ;;
  restart) cmd_restart "${2:-local}" ;;
  status)  cmd_status ;;
  attach)  cmd_attach ;;
  *)
    echo "usage: twinr start|restart [local|prod]  |  twinr stop|status|attach" >&2
    exit 2
    ;;
esac
